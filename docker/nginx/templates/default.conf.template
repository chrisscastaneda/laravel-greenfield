# Rendered by the Nginx image's envsubst step on container start.
# Only variables defined in the container environment are substituted.

server {
    listen 80;
    listen [::]:80;
    server_name ${NGINX_SERVER_NAME};

    # Let's Encrypt HTTP-01 challenges (see the certbot service in compose.prod.yaml).
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${NGINX_SERVER_NAME};

    # Generated by /docker-entrypoint.d/15-greenfield-ssl.sh
    include /etc/nginx/snippets/greenfield-ssl-cert.conf;
    include /etc/nginx/snippets/ssl-params.conf;

    root /var/www/html/public;
    index index.php;
    charset utf-8;
    client_max_body_size 20M;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # Empty in development (header omitted); set NGINX_HSTS in production.
    add_header Strict-Transport-Security "${NGINX_HSTS}" always;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Fingerprinted Vite assets can be cached forever.
    location /build/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
        try_files $uri =404;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    error_page 404 /index.php;

    location ~ ^/index\.php(/|$) {
        set $php_upstream ${NGINX_PHP_UPSTREAM};
        fastcgi_pass $php_upstream;
        fastcgi_split_path_info ^(.+\.php)(/.*)$;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_param HTTPS on;
        fastcgi_hide_header X-Powered-By;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
        fastcgi_read_timeout 60s;
    }

    # Block every other .php file and hidden files (except .well-known).
    location ~ \.php$ { return 404; }
    location ~ /\.(?!well-known).* { deny all; }
}
