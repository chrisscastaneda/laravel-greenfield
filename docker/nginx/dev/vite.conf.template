# Development only: proxy the Vite dev server over HTTPS so the HTTPS app
# page can load HMR assets without mixed-content errors.
server {
    listen 5173 ssl;
    listen [::]:5173 ssl;
    http2 on;
    server_name ${NGINX_SERVER_NAME};

    include /etc/nginx/snippets/greenfield-ssl-cert.conf;
    include /etc/nginx/snippets/ssl-params.conf;

    location / {
        set $vite_upstream ${NGINX_VITE_UPSTREAM};
        proxy_pass http://$vite_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 1h;
    }
}
